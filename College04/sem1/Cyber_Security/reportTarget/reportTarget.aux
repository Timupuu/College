\abx@aux@refcontext{nty/global//global/global/global}
\providecommand \babel@aux [2]{\global \let \babel@toc \@gobbletwo }
\@nameuse{bbl@beforestart}
\babel@aux{english}{}
\@writefile{toc}{\contentsline {section}{\numberline {0.1}Introduction}{2}{}\protected@file@percent }
\newlabel{sec:intro}{{0.1}{2}{}{section.0.1}{}}
\@writefile{toc}{\contentsline {paragraph}{During the last two decades in the feild of cybersecurity, many \nobreak  incidents have taken place which has helped to bring the realm of cyber and infomation security to the place it is now}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{With events such as the 2013 data breach of MySpace where 360 million users had their login credentials stolen, in the same year the personal information of 3 billion Yahoo users was compromised.}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Target was third-largest retailor in United States and operated numerous stores within Canada and U.S upto 2000 stores.}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The attack occured during holiday season via the POS i.e point of sale machine where the information of 70 million customer and the credit card of 40 million users were also compromised.}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {0.2}Unfolding}{3}{}\protected@file@percent }
\newlabel{sec:unfold}{{0.2}{3}{}{section.0.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {0.2.1}Security}{3}{}\protected@file@percent }
\newlabel{ssec:secu}{{0.2.1}{3}{}{subsection.0.2.1}{}}
\@writefile{toc}{\contentsline {paragraph}{ Every cyber crime starts with a vulnerability.}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {0.2.2}Blunders}{3}{}\protected@file@percent }
\newlabel{ssec:blund}{{0.2.2}{3}{}{subsection.0.2.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Even though they had such level of protection they failed to detect as well as prevent some:}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {0.2.3}Breach}{3}{}\protected@file@percent }
\newlabel{ssec:breach}{{0.2.3}{3}{}{subsection.0.2.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{Phase: 1 Infection }{3}{}\protected@file@percent }
\newlabel{sssec:p1}{{0.2.3}{3}{}{subsection.0.2.3}{}}
\@writefile{toc}{\contentsline {paragraph}{\indent Using phishing emails the attackers were able to infect Fazio's system.}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\indent After the access into the target's network through fazio mechanical the attackers were able to access Target's Ariba external billing system or the business section of Target.}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Phase: 2 PoS Infection }{4}{}\protected@file@percent }
\newlabel{sssec:p2}{{0.2.3}{4}{}{subsection.0.2.3}{}}
\@writefile{toc}{\contentsline {paragraph}{\indent They named this "Webs shell to look like a authentic file, now they had remote control over the Target's servers.}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{Phase 3: Prvilege and extraction}{4}{}\protected@file@percent }
\newlabel{sssec:p3}{{0.2.3}{4}{}{subsection.0.2.3}{}}
\@writefile{toc}{\contentsline {paragraph}{\indent After the acess and the successful hijacking of the PoS systems the attackers were just a few steps away from entering and extracting the data but they were in need of privilege i.e Domain Admin privileges.}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\indent After succesfully gaining access they used those privileges to create their own seperate Domain Access account}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\indent During peak time they would harvest the info stored in the PoS systems}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {0.3}Consequences}{5}{}\protected@file@percent }
\newlabel{sec:cons}{{0.3}{5}{}{section.0.3}{}}
\@writefile{toc}{\contentsline {paragraph}{After the attack was revealed a few weeks, Target faced numerous lawsuits from various parties.}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {0.4}Methodologies}{6}{}\protected@file@percent }
\newlabel{sec:met}{{0.4}{6}{}{section.0.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Here we will go indepth about the malware and exploits used and their functionalities:}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textit  {A flowchart of the attack}}}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {0.5}Conclusion}{8}{}\protected@file@percent }
\newlabel{sec:conc}{{0.5}{8}{}{section.0.5}{}}
\@writefile{toc}{\contentsline {paragraph}{From this cyber attack we can conclude how outsourcing was one of the major instigator of this whole event.}{8}{}\protected@file@percent }
